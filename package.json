{
  "name": "mostarda-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "node --experimental-strip-types --watch apps/cloud-api/src/main.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "start:api": "node --experimental-strip-types apps/cloud-api/src/main.ts",
    "mostarda:e2e": "node --experimental-strip-types scripts/run-mostarda-e2e.ts",
    "edge:e2e": "node --experimental-strip-types scripts/run-real-edge-e2e.ts",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "test:all": "npm run test && npm run test:architecture && npm run test:docs",
    "test:architecture": "node --test \"tests/architecture/*.test.mjs\"",
    "test:docs": "node --test \"tests/documentation/*.test.mjs\"",
    "test:conformance": "node --experimental-strip-types --test \"tests/conformance/*.test.ts\"",
    "test:integration": "node --experimental-strip-types --test \"tests/integration/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "fastify": "^5.8.5",
    "pg": "^8.16.3"
  }
}
