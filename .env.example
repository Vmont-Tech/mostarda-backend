# MOSTARDA — Environment Variables Reference
# Copy this file to .env and fill in your values.

# Database
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mostarda
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mostarda

# Supabase Auth (GoTrue)
GOTRUE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_MAILER_AUTOCONFIRM=true

# PostgREST
PGRST_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters
PGRST_DB_SCHEMA=public,api
PGRST_DB_ANON_ROLE=anon

# Blockchain (optional - mock usado por padrão)
QUANTUM_CERT_API_KEY=
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLA_ASSET_CODE=MOSTARDA
SOLANA_RPC_URL=https://api.devnet.solana.com

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=

# Oracle VPS
VPS_IP=
VPS_USER=ubuntu
DOMAIN=mostarda.app
