# ── MOSTARDA Backend Environment Variables ──
# Copy this to .env and fill in your values

APP_NAME=mostarda-backend
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-random-32-char-min
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mostarda
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/mostarda

# PSAV (Depix / Mercado Bitcoin / Liqi)
PSAV_PROVIDER=depix
PSAV_API_KEY=sua_chave_psav
PSAV_API_SECRET=seu_secret_psav
PSAV_WEBHOOK_SECRET=webhook_secret
PSAV_STABLECOIN=BRLX

# Stellar (Primary Blockchain)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_DISTRIBUTION_SEED=
STELLAR_ASSET_CODE=BRLX

# Solana (Fallback Blockchain)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_FALLBACK_WALLET=

# DeFi Yield
YIELD_POOL_ADDRESS=
YIELD_POOL_PROTOCOL=aave
YIELD_MIN_HOLD_HOURS=24

# Telemetry
AUDIENCE_CONFIDENCE_THRESHOLD=0.5
PROXIMITY_RSSI_THRESHOLD=-70
