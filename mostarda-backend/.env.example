# ── MOSTARDA Backend Environment Variables ──
# Copy this to .env and fill in your values
#
# Revenue Split (alinhado ao manual do projeto):
#   Dono do Ponto:     25% → Mensal
#   Dono da TV:        20% → Mensal
#   Vendedor:          20% → Semanal
#   Embaixador:        10% → Semanal
#   Mostarda (Holding): 25% → Mensal
#                     ─────
#   Total:            100%
#
# Blockchain:
#   Primária: Stellar (low fee, predictable)
#   Fallback: Solana (auto-ativação se fee > threshold)
#   Padrão: EIP-2535 Diamond


# ── App ─────────────────────────────────────────────────────
APP_NAME=mostarda-backend
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-random-32-char-min
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mostarda
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/mostarda


# ── PSAV (Depix / Mercado Bitcoin / Liqi) ──────────────────
PSAV_PROVIDER=depix
PSAV_API_KEY=sua_chave_psav
PSAV_API_SECRET=seu_secret_psav
PSAV_WEBHOOK_SECRET=webhook_secret
PSAV_STABLECOIN=BRLX


# ── Settlement Cycles (Off-Ramp) ───────────────────────────
# Off-ramp automático em lotes:
# - Semanal: Vendedores (20%) + Embaixadores (10%)  → 7 dias
# - Mensal:  Donos (25%+20%) + Holding (25%)        → 30 dias
SETTLEMENT_WEEKLY_DAYS=7
SETTLEMENT_MONTHLY_DAYS=30


# ── Blockchain (Stellar → Primária) ────────────────────────
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_DISTRIBUTION_SEED=
STELLAR_ASSET_CODE=BRLX

# Threshold de fee para ativar fallback (em XLM)
BLOCKCHAIN_FEE_THRESHOLD_XLM=0.001
# Cooldown do circuit breaker (segundos antes de retentar Stellar)
BLOCKCHAIN_CIRCUIT_COOLDOWN_SECONDS=300


# ── Blockchain (Solana → Fallback) ─────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_FALLBACK_WALLET=


# ── DeFi Yield ─────────────────────────────────────────────
YIELD_POOL_ADDRESS=
YIELD_POOL_PROTOCOL=aave
YIELD_MIN_HOLD_HOURS=24


# ── Telemetry ──────────────────────────────────────────────
AUDIENCE_CONFIDENCE_THRESHOLD=0.5
PROXIMITY_RSSI_THRESHOLD=-70
